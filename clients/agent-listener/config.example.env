# Agent-listener example config — copy to
# ~/.config/message-board/agent-listener.env (mode 0600) and fill in
# your values. install.sh --role agent-listener writes this file for you.
# Environment variables override the file.

# Board WebSocket URL (required — no built-in default).
BOARD_WS_URL=wss://<your-host>/board/ws

# Board web URL (reported in the listener's stdout payload; defaults to
# the WS URL with wss:// -> https:// and the trailing /ws removed).
BOARD_URL=https://<your-host>/board

# Bearer-token file (0600) and last-seen-ID file. Defaults (used when
# these lines are absent): ~/.local/share/message-board/state/
# message-board.token and .../message-board.last.
# TOKEN_FILE=
# LAST_FILE=
